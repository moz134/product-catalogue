# Copy to .env to override defaults. Every value is optional; the app runs without a .env file.
# Never commit .env.

# --- Server ---
# PORT=3000
# LOG_LEVEL=info              # fatal | error | warn | info | debug | trace | silent
# TRUST_PROXY=false           # true when behind a reverse proxy / load balancer

# --- Product data source ---
# PRODUCT_SOURCE=fakestore    # only adapter today; add others in apps/api/src/container.ts
# FAKESTORE_BASE_URL=https://fakestoreapi.com
# UPSTREAM_TIMEOUT_MS=5000
# PRODUCT_CACHE_TTL_SECONDS=300   # 0 disables caching
# CURRENCY=USD

# --- Merchandising ---
# The owner's chosen "top rated" products, in display order.
FEATURED_PRODUCT_IDS=1,5,9,13,18
# FEATURED_COUNT=5            # products on the home page
# CATEGORY_TOP_RATED_COUNT=3  # top-rated products at the top of each category page

# --- Email ---
# console = log emails instead of sending (local dev without Docker)
# smtp    = send via SMTP (Docker Compose points this at Mailpit)
EMAIL_PROVIDER=console
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
SALES_INBOX_EMAIL=sales@example.com
ENQUIRY_FROM_EMAIL=no-reply@example.com

# --- Abuse protection ---
# ENQUIRY_RATE_LIMIT_PER_MINUTE=5    # Docker Compose sets 30 for local testing
